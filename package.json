{
  "name": "codex-account-manager",
  "productName": "Egoist Account Manager",
  "version": "3.1.6",
  "description": "Egoist Account Manager — local Windows profile switcher and quota dashboard for user-authorized AI coding accounts.",
  "author": "Egoist Gorbachev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/egoist-ai1/egoist-account-manager.git"
  },
  "type": "module",
  "main": "dist/main/main.js",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.main.json --watch --preserveWatchOutput\" \"wait-on http://127.0.0.1:5173 dist/main/main.js && pnpm run build:preload && cross-env NODE_ENV=development electron .\"",
    "rebuild:native:node": "pnpm rebuild better-sqlite3",
    "rebuild:native:electron": "electron-rebuild -f -w better-sqlite3",
    "repair:native": "pnpm run rebuild:native:node",
    "icons:build": "node scripts/generate-icons.mjs",
    "clean:dist": "node scripts/clean-build-output.mjs",
    "build:preload": "esbuild src/main/preload.ts --bundle --platform=browser --format=cjs --external:electron --outfile=dist/main/preload.cjs",
    "build": "pnpm run typecheck && pnpm run lint && pnpm run clean:dist && tsc -p tsconfig.main.json && pnpm run build:preload && vite build && pnpm run rebuild:native:electron && electron-builder --win nsis portable",
    "build:dir": "pnpm run typecheck && pnpm run lint && pnpm run clean:dist && tsc -p tsconfig.main.json && pnpm run build:preload && vite build && pnpm run rebuild:native:electron && electron-builder --dir",
    "preview": "vite preview --host 127.0.0.1",
    "smoke": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "test": "vitest",
    "test:run": "vitest run",
    "test:node": "pnpm run rebuild:native:node && vitest run",
    "test:electron": "pnpm run build:dir && playwright test",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:startup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-packaged-startup.ps1",
    "verify:tray-native": "electron scripts/verify-live-tray-native.cjs",
    "verify:sandbox": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/run-windows-sandbox-release-test.ps1",
    "verify:sandbox:apply": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/run-windows-sandbox-release-test.ps1 -Apply",
    "verify:sandbox:live": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/run-windows-sandbox-live-e2e.ps1",
    "verify:sandbox:live:apply": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/run-windows-sandbox-live-e2e.ps1 -Apply",
    "verify:sandbox:live:finalize": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/run-windows-sandbox-live-e2e.ps1 -Apply -Finalize",
    "release:checksums": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/write-checksums.ps1"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.2.8",
    "better-sqlite3": "^12.4.6",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.561.0",
    "nanoid": "^5.1.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@electron/asar": "3.4.1",
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "9.0.0",
    "@playwright/test": "^1.57.0",
    "@vitejs/plugin-react": "^4.6.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "esbuild": "0.28.1",
    "eslint": "9.0.0",
    "png-to-ico": "^3.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.0.0",
    "vite": "^7.0.4",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "one.egoist.codex-account-manager",
    "productName": "Egoist Account Manager",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "egoist-ai1",
        "repo": "egoist-account-manager",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "assets/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      }
    ],
    "directories": {
      "output": "release"
    },
    "afterPack": "./scripts/afterPack.mjs",
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": true,
      "signExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "artifactName": "Egoist-Account-Manager-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "shortcutName": "Egoist Account Manager",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Egoist-Account-Manager-${version}.${ext}"
    }
  }
}
